REMNA_TOKEN=your_bearer_token_here
REMNA_BASE_URL=https://your-remna-host/api
GITHUB_RAW_URL=https://raw.githubusercontent.com/hydraponique/roscomvpn-happ-routing/refs/heads/main/HAPP/DEFAULT.DEEPLINK
CHECK_INTERVAL=300

# Альтернатива CHECK_INTERVAL: запуск по расписанию (cron-выражение).
# Если задано — CHECK_INTERVAL игнорируется, проверка идёт по cron
# (плюс один раз сразу при старте). Время — в часовом поясе контейнера (по умолчанию UTC).
# Пример: каждый день в 09:00.
# CRON_SCHEDULE=0 9 * * *

# Название роутинга (заменяет "Name" из GitHub-конфига, показывается в приложении Happ)
# ROUTING_NAME=Березка VPN
# SQUAD_1_NAME=Березка VPN

# Дополнительные правила роутинга (добавляются к данным из GitHub, через запятую)
# ROUTING_EXTRA_DIRECT_SITES=geosite:my-domain,geosite:another
# ROUTING_EXTRA_DIRECT_IP=geoip:my-range
# ROUTING_EXTRA_PROXY_SITES=geosite:example
# ROUTING_EXTRA_PROXY_IP=geoip:example
# ROUTING_EXTRA_BLOCK_SITES=geosite:example
# ROUTING_EXTRA_BLOCK_IP=geoip:example

# Вырезать правила из апстримного роутинга (применяется до extras).
# Коды из кастомных roscomvpn-баз ломают клиенты со стандартным geosite.dat/geoip.dat.
# ROUTING_REMOVE_PROXY_SITES=geosite:twitch-ads
# ROUTING_REMOVE_DIRECT_SITES=geosite:whitelist
# ROUTING_REMOVE_BLOCK_SITES=geosite:torrent
# ROUTING_REMOVE_DIRECT_IP=geoip:direct

# Внешние сквады (опционально, у каждого свой GitHub URL)
# SQUAD_1_UUID=your-first-squad-uuid-here
# SQUAD_1_URL=https://raw.githubusercontent.com/.../SQUAD1.DEEPLINK
# SQUAD_1_EXTRA_DIRECT_SITES=geosite:my-domain
# SQUAD_2_UUID=your-second-squad-uuid-here
# SQUAD_2_URL=https://raw.githubusercontent.com/.../SQUAD2.DEEPLINK
