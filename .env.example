REMNA_TOKEN=your_bearer_token_here
REMNA_BASE_URL=https://your-remna-host/api
GITHUB_RAW_URL=https://raw.githubusercontent.com/hydraponique/roscomvpn-happ-routing/refs/heads/main/HAPP/DEFAULT.DEEPLINK
CHECK_INTERVAL=300

# Альтернатива CHECK_INTERVAL: запуск по расписанию (cron-выражение).
# Если задано — CHECK_INTERVAL игнорируется, проверка идёт по cron
# (плюс один раз сразу при старте). Время — в часовом поясе контейнера (по умолчанию UTC).
# Пример: каждый день в 09:00.
# CRON_SCHEDULE=0 9 * * *

# Внешние сквады (опционально, у каждого свой GitHub URL)
# SQUAD_1_UUID=your-first-squad-uuid-here
# SQUAD_1_URL=https://raw.githubusercontent.com/.../SQUAD1.DEEPLINK
# SQUAD_2_UUID=your-second-squad-uuid-here
# SQUAD_2_URL=https://raw.githubusercontent.com/.../SQUAD2.DEEPLINK
